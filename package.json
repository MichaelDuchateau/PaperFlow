{
  "name": "paperflow",
  "version": "1.0.0",
  "description": "Local-first academic paper reading app",
  "author": "PaperFlow",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "preview": "vite preview",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.33.0",
    "better-sqlite3": "^11.0.0",
    "codemirror": "^6.0.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.paperflow.app",
    "productName": "PaperFlow",
    "copyright": "Copyright © 2025 PaperFlow",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },

    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],

    "asarUnpack": [
      "**/*.node",
      "**/pdf-parse/**",
      "**/bindings/**",
      "**/file-uri-to-path/**"
    ],

    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },

    "dmg": {
      "title": "${productName} ${version}",
      "sign": false
    },

    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PaperFlow"
    },

    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Education"
    },

    "npmRebuild": true,
    "publish": null
  }
}
